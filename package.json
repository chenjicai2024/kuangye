{
  "name": "kuangye-desktop-agent",
  "version": "2.0.0",
  "description": "Kuangye Desktop Agent - AI-powered cross-platform desktop RPA client based on Electron and VLM",
  "main": "./out/main/index.js",
  "author": "kuangye-dev",
  "license": "Apache-2.0",
  "homepage": "https://github.com/kuangye-dev/kuangye-desktop-agent",
  "overrides": {
    "@hurdlegroup/robotjs": {
      "node-addon-api": "^8.7.0"
    }
  },
  "scripts": {
    "test:model-provider": "cross-env TS_NODE_COMPILER_OPTIONS={\\\"module\\\":\\\"CommonJS\\\",\\\"esModuleInterop\\\":true} node -r ts-node/register/transpile-only scripts/test-model-provider.ts",
    "test:agent-assistant": "cross-env TS_NODE_COMPILER_OPTIONS={\\\"module\\\":\\\"CommonJS\\\",\\\"esModuleInterop\\\":true} node -r ts-node/register/transpile-only scripts/test-agent-assistant.ts",
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "node scripts/dev-launch.mjs",
    "dev:test-screenshot": "electron-vite build && cross-env TEST_MODE=screenshot electron ./out/main/test-cli.js",
    "dev:test-reply": "electron-vite build && cross-env TEST_MODE=reply electron ./out/main/test-cli.js",
    "dev:test-switch": "electron-vite build && cross-env TEST_MODE=switch electron ./out/main/test-cli.js",
    "dev:test-chat-history": "electron-vite build && electron ./out/main/test-chat-history-cli.js",
    "test:chat-history": "cross-env TS_NODE_COMPILER_OPTIONS={\\\"module\\\":\\\"CommonJS\\\",\\\"esModuleInterop\\\":true} node -r ts-node/register/transpile-only scripts/test-chat-history.ts",
    "test:template-utils": "cross-env TS_NODE_COMPILER_OPTIONS={\\\"module\\\":\\\"CommonJS\\\",\\\"esModuleInterop\\\":true} node -r ts-node/register/transpile-only scripts/test-template-utils.ts",
    "test:text-input-chunks": "cross-env TS_NODE_COMPILER_OPTIONS={\\\"module\\\":\\\"CommonJS\\\",\\\"esModuleInterop\\\":true} node -r ts-node/register/transpile-only scripts/test-text-input-chunks.ts",
    "test:wait-utils": "cross-env TS_NODE_COMPILER_OPTIONS={\\\"module\\\":\\\"CommonJS\\\",\\\"esModuleInterop\\\":true} node -r ts-node/register/transpile-only scripts/test-wait-utils.ts",
    "test:random-branch": "cross-env TS_NODE_COMPILER_OPTIONS={\\\"module\\\":\\\"CommonJS\\\",\\\"esModuleInterop\\\":true} node -r ts-node/register/transpile-only scripts/test-random-branch.ts",
    "test:random-mouse": "cross-env TS_NODE_COMPILER_OPTIONS={\\\"module\\\":\\\"CommonJS\\\",\\\"esModuleInterop\\\":true} node -r ts-node/register/transpile-only scripts/test-random-mouse.ts",
    "test:ai-action-coordinates": "cross-env TS_NODE_COMPILER_OPTIONS={\\\"module\\\":\\\"CommonJS\\\",\\\"esModuleInterop\\\":true} node -r ts-node/register/transpile-only scripts/test-ai-action-coordinates.ts",
    "test:token-usage": "cross-env TS_NODE_COMPILER_OPTIONS={\\\"module\\\":\\\"CommonJS\\\",\\\"esModuleInterop\\\":true} node -r ts-node/register/transpile-only scripts/test-token-usage.ts",
    "test:condition-utils": "cross-env TS_NODE_COMPILER_OPTIONS={\\\"module\\\":\\\"CommonJS\\\",\\\"esModuleInterop\\\":true} node -r ts-node/register/transpile-only scripts/test-condition-utils.ts",
    "test:serial-task-queue": "cross-env TS_NODE_COMPILER_OPTIONS={\\\"module\\\":\\\"CommonJS\\\",\\\"esModuleInterop\\\":true} node -r ts-node/register/transpile-only scripts/test-serial-task-queue.ts",
    "test:flow-geometry": "cross-env TS_NODE_COMPILER_OPTIONS={\\\"module\\\":\\\"CommonJS\\\",\\\"esModuleInterop\\\":true} node -r ts-node/register/transpile-only scripts/test-flow-geometry.ts",
    "test:action-chain-validation": "cross-env TS_NODE_COMPILER_OPTIONS={\\\"module\\\":\\\"CommonJS\\\",\\\"esModuleInterop\\\":true} node -r ts-node/register/transpile-only scripts/test-action-chain-validation.ts",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "patch-package && electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@hurdlegroup/robotjs": "^0.12.3",
    "active-win": "^8.2.1",
    "better-sqlite3": "^13.0.2",
    "electron-store": "^11.0.2",
    "jimp": "^1.6.1",
    "node-window-manager": "^2.2.4",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "cross-env": "^10.1.0",
    "electron": "^39.8.10",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "patch-package": "^8.0.1",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  }
}
